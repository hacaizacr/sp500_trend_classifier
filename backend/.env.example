# Copia este archivo como .env  (cp .env.example .env). El archivo .env NO se sube a git.

# --- LOCAL (por defecto): el modelo se lee de la carpeta model/ ---
MODEL_SOURCE=local

# --- AWS (EC2): el modelo se descarga de S3 con el rol IAM de la instancia ---
# MODEL_SOURCE=s3
# S3_BUCKET=nombre-de-tu-bucket
# S3_PREFIX=modelo/
# AWS_REGION=us-east-1

# CORS: solo importa si el frontend se sirve desde OTRO origen. Servido desde FastAPI no se usa.
# En producción puedes dejarlo vacío:  CORS_ORIGINS=
CORS_ORIGINS=*
