{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerModeloDesdeS3",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::NOMBRE-DEL-BUCKET/modelo/*"
    },
    {
      "Sid": "ListarBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::NOMBRE-DEL-BUCKET"
    }
  ]
}
